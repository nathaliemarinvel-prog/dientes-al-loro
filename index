<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Dientes al Loro</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    body {
      background: #1a1a2e;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
      font-family: 'Segoe UI', sans-serif;
    }
    canvas {
      background: linear-gradient(180deg, #16213e 0%, #0f3460 100%);
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      max-width: 100%;
      max-height: 100%;
    }
  </style>
</head>
<body>

<canvas id="gameCanvas" width="360" height="640"></canvas>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let score = 0;
let money = 0;
let gameOver = false;

// Personaje (Búho / Loro alternable)
const bird = {
  x: 180,
  y: 90,
  radius: 35,
  speed: 3,
  dir: 1,
  type: '🦉', // Cambia entre búho y loro
  hasTeeth: false
};

// Dientes lanzables
const teeth = {
  x: 180,
  y: 560,
  radius: 20,
  speedY: 0,
  isFlying: false
};

// Objetos que caen (Burbujas = peligro, Flores = dinero)
let items = [];
let frameCount = 0;

function resetTeeth() {
  teeth.x = 180;
  teeth.y = 560;
  teeth.speedY = 0;
  teeth.isFlying = false;
}

function resetGame() {
  score = 0;
  items = [];
  gameOver = false;
  bird.speed = 3;
  resetTeeth();
}

// Lanzar dientes al tocar la pantalla
canvas.addEventListener('pointerdown', () => {
  if (gameOver) {
    resetGame();
    return;
  }
  if (!teeth.isFlying) {
    teeth.isFlying = true;
    teeth.speedY = -11;
  }
});

function spawnItem() {
  const isFlower = Math.random() < 0.35; // 35% probabilidad de flor con dinero
  items.push({
    x: Math.random() * (canvas.width - 60) + 30,
    y: -20,
    radius: 18,
    speedY: Math.random() * 2 + 1.5,
    type: isFlower ? '🌸' : '🫧',
    isFlower: isFlower
  });
}

function update() {
  if (gameOver) return;
  frameCount++;

  // Movimiento del ave
  bird.x += bird.speed * bird.dir;
  if (bird.x + bird.radius > canvas.width - 10 || bird.x - bird.radius < 10) {
    bird.dir *= -1;
  }

  // Movimiento de los dientes
  if (teeth.isFlying) {
    teeth.y += teeth.speedY;
    if (teeth.y < -30) resetTeeth(); // Falló el tiro
  }

  // Generar burbujas y flores
  if (frameCount % 55 === 0) {
    spawnItem();
  }

  // Actualizar burbujas y flores
  for (let i = items.length - 1; i >= 0; i--) {
    let item = items[i];
    item.y += item.speedY;

    // Colisión entre dientes y burbuja/flor
    const distTeeth = Math.hypot(teeth.x - item.x, teeth.y - item.y);
    if (distTeeth < teeth.radius + item.radius) {
      if (item.isFlower) {
        money += 10; // ¡Dinero recogido!
        items.splice(i, 1);
        continue;
      } else {
        // ¡Burbuja explotó! Reinicia
        gameOver = true;
      }
    }

    // Si una burbuja golpea al ave directamente
    const distBird = Math.hypot(bird.x - item.x, bird.y - item.y);
    if (distBird < bird.radius + item.radius && !item.isFlower) {
      gameOver = true;
    }

    if (item.y > canvas.height + 30) {
      items.splice(i, 1);
    }
  }

  // Colisión: ¡Dientes encajados en el ave!
  const distGoal = Math.hypot(bird.x - teeth.x, bird.y - teeth.y);
  if (teeth.isFlying && distGoal < bird.radius + teeth.radius) {
    score++;
    bird.type = bird.type === '🦉' ? '🦜' : '🦉'; // Alterna búho y loro
    bird.speed += 0.3; // Aumenta dificultad
    resetTeeth();
  }
}

function draw() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Marcadores
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 20px sans-serif';
  ctx.fillText(`Puntos: ${score}`, 20, 35);
  ctx.fillStyle = '#ffd166';
  ctx.fillText(`💵 $${money}`, 240, 35);

  // Dibujar Ave
  ctx.font = '60px serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(bird.type, bird.x, bird.y);

  // Dibujar Burbujas y Flores
  ctx.font = '32px serif';
  items.forEach(item => {
    ctx.fillText(item.type, item.x, item.y);
  });

  // Dibujar Dientes
  ctx.font = '38px serif';
  ctx.fillText('🦷', teeth.x, teeth.y);

  // Pantalla de reinicio
  if (gameOver) {
    ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#ff6b6b';
    ctx.font = 'bold 30px sans-serif';
    ctx.fillText('¡BUM! Burbuja 💥', canvas.width / 2, canvas.height / 2 - 20);
    ctx.fillStyle = '#fff';
    ctx.font = '18px sans-serif';
    ctx.fillText('Toca para volver a empezar', canvas.width / 2, canvas.height / 2 + 25);
  }
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

loop();
</script>
</body>
</html>
